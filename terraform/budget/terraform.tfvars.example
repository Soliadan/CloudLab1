account_id = "REPLACE_BUDGET_OWNER_ACCOUNT_ID"
region = "eu-north-1"
# In private terraform.tfvars set budget_email_addresses to EXACT existing email(s).
# budget_email_addresses = [ ... ]
# Also supply cost_types with ALL flags read from describe-budget; no defaults are assumed.
# Example shape (replace each value using the real AWS response, do not copy guesses):
# cost_types = {
#   include_credit = true
#   include_discount = ...
#   include_other_subscription = ...
#   include_recurring = ...
#   include_refund = ...
#   include_subscription = ...
#   include_support = ...
#   include_tax = ...
#   include_upfront = ...
#   use_amortized = ...
#   use_blended = ...
# }
adoption_reviewed = false
# cost_filters = {} # verify actual scope; no project-only filter is added implicitly
# budget_tags = {}  # verify before adoption

# time_period_start = "..." # exact existing UTC timestamp, YYYY-MM-DD_HH:mm
# time_period_end = "..."   # do not assume the provider default
